{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ctelectricreps.com" }],
      "destination": "https://ctelectricreps.com/:path*",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/our-team/",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/products/",
      "destination": "/manufacturers/",
      "permanent": true
    },
    {
      "source": "/cloud-hosted-epms/",
      "destination": "/meter-sight/",
      "permanent": true
    }
  ]
}
