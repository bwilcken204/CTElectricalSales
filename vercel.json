{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/our-team",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/manufacturers/",
      "permanent": true
    },
    {
      "source": "/cloud-hosted-epms",
      "destination": "/meter-sight/",
      "permanent": true
    }
  ]
}
